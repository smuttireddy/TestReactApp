@{
    ViewData["Title"] = "Upload Log File";
}

<div class="container py-5" style="max-width:640px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h2 class="fw-semibold mb-1" style="color:#1e3a5f;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor"
                     class="bi bi-file-earmark-text me-2" viewBox="0 0 16 16">
                    <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 2a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 2a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2z"/>
                    <path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0zm0 1v3.5H13L9.5 1zM4 2h4.5v3A1.5 1.5 0 0 0 10 6.5H13V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z"/>
                </svg>
                Log Analyzer
            </h2>
            <p class="text-muted mb-4">Upload a <code>.log</code> or <code>.txt</code> file. The AI engine will identify errors, root causes, solutions, and recommended actions.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <form method="post" enctype="multipart/form-data" asp-action="Upload" asp-controller="Log">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-medium">Select log file</label>
                    <input type="file" name="file" accept=".log,.txt" class="form-control" required />
                    <div class="form-text">Accepted: <code>.log</code>, <code>.txt</code> &mdash; max 10 MB</div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    Analyze Log File
                </button>
            </form>
        </div>
    </div>
</div>
